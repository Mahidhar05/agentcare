# ═══════════════════════════════════════════════════════════════
# AGENTCARE ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your actual values
# ═══════════════════════════════════════════════════════════════

# ── App ──────────────────────────────────────────────────────
APP_NAME=AgentCare
DEBUG=false

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=sqlite:///./agentcare.db

# ── JWT Auth ─────────────────────────────────────────────────
SECRET_KEY=your-super-secret-key-change-this-in-production-make-it-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── LLM (Groq) ───────────────────────────────────────────────
GROQ_API_KEY=your-groq-api-key-here
LLM_MODEL=llama3-70b-8192
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

# ── File Upload ───────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# ── API Server ────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
FASTAPI_URL=http://localhost:8000

# ── Streamlit ─────────────────────────────────────────────────
STREAMLIT_PORT=8501